# BasicLabelFlow

main: kit: flow: BasicLabelFlow:
{
  entity: "label",
  kind: "basic",
  name: "BasicLabelFlow",
  step: [
    {
      input: {
        ref: "label_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "label_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "label_ref01",
        srcdatavar: "label_ref01_data",
        suffix: "_up0",
        textfield: "app_url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-label_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "label_ref01",
        srcdatavar: "label_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "label01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-label_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "label_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "label01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "label_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLabelFlow"
}
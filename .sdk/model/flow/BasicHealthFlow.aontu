# BasicHealthFlow

main: kit: flow: BasicHealthFlow:
{
  entity: "health",
  kind: "basic",
  name: "BasicHealthFlow",
  step: [
    {
      input: {
        ref: "health_ref01"
      }

      match: {
        epic_id: "epic01"
      }

      op: "create"
    }

    {
      match: {
        epic_id: "epic01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "health_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "health_ref01",
        srcdatavar: "health_ref01_data",
        suffix: "_up0",
        textfield: "author_id"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-health_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "health_ref01",
        srcdatavar: "health_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "health01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-health_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHealthFlow"
}
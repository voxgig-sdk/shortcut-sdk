# BasicStoryReactionFlow

main: kit: flow: BasicStoryReactionFlow:
{
  entity: "story_reaction",
  kind: "basic",
  name: "BasicStoryReactionFlow",
  step: [
    {
      input: {
        ref: "story_reaction_ref01"
      }

      match: {
        comment_id: "comment01",
        story_id: "story01"
      }

      op: "create"
    }

    {
      input: {
        ref: "story_reaction_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "story_reaction01",
        story_id: "story01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicStoryReactionFlow"
}
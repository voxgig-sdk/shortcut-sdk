# BasicStoryLinkFlow

main: kit: flow: BasicStoryLinkFlow:
{
  entity: "story_link",
  kind: "basic",
  name: "BasicStoryLinkFlow",
  step: [
    {
      input: {
        ref: "story_link_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "story_link_ref01",
        srcdatavar: "story_link_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-story_link_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "story_link_ref01",
        srcdatavar: "story_link_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "story_link01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-story_link_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "story_link_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "story_link01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicStoryLinkFlow"
}